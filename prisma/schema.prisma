generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum GameType {
  QUIZ
  TRUE_FALSE
  MEMORY_MATCH
  WORD_SCRAMBLE
  SEQUENCE
  FILL_BLANK
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum RewardType {
  SCRATCH_CARD
  PASS
}

enum RewardStatus {
  UNSCRATCHED
  AVAILABLE
  REDEEMED
  EXPIRED
  REVOKED
}

model User {
  id           String   @id @default(cuid())
  clerkId      String   @unique
  email        String   @unique
  name         String?
  imageUrl     String?
  role         Role     @default(USER)
  isBanned     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  syncedAt     DateTime @default(now())
  lastActiveAt DateTime @default(now())

  memberships      ClubMembership[]
  attempts         GameAttempt[]
  ledger           PointsLedger[]
  questCompletions QuestCompletion[]
  rewards          Reward[]
}

model Club {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @default("")
  icon        String   @default("🎮")
  color       String   @default("#8b5cf6")
  coverImage  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships ClubMembership[]
  games       Game[]
  quests      Quest[]
  seasons     Season[]
  attempts    GameAttempt[]
  ledger      PointsLedger[]
  rewards     Reward[]
}

model ClubMembership {
  id       String   @id @default(cuid())
  userId   String
  clubId   String
  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([userId, clubId])
  @@index([clubId])
}

model Game {
  id          String     @id @default(cuid())
  clubId      String
  title       String
  description String     @default("")
  type        GameType
  difficulty  Difficulty @default(MEDIUM)
  points      Int        @default(100)
  timeLimit   Int?
  content     Json
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  club       Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  attempts   GameAttempt[]
  questGames QuestGame[]

  @@index([clubId])
}

model GameAttempt {
  id           String   @id @default(cuid())
  userId       String
  gameId       String
  clubId       String
  seasonId     String?
  score        Float
  maxScore     Float
  accuracy     Float
  pointsEarned Int
  timeTaken    Int
  passed       Boolean
  createdAt    DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  game   Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  club   Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  season Season? @relation(fields: [seasonId], references: [id], onDelete: SetNull)

  @@index([userId, gameId])
  @@index([clubId, createdAt])
  @@index([createdAt])
}

model Quest {
  id          String    @id @default(cuid())
  clubId      String
  title       String
  description String    @default("")
  bonusPoints Int       @default(250)
  startsAt    DateTime  @default(now())
  endsAt      DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  club        Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  games       QuestGame[]
  completions QuestCompletion[]

  @@index([clubId])
}

model QuestGame {
  id        String @id @default(cuid())
  questId   String
  gameId    String
  sortOrder Int    @default(0)

  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)
  game  Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([questId, gameId])
}

model QuestCompletion {
  id          String   @id @default(cuid())
  userId      String
  questId     String
  completedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, questId])
}

model Season {
  id          String    @id @default(cuid())
  clubId      String
  name        String
  startsAt    DateTime
  endsAt      DateTime
  finalizedAt DateTime?
  createdAt   DateTime  @default(now())

  club     Club           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  tiers    RewardTier[]
  rewards  Reward[]
  attempts GameAttempt[]
  ledger   PointsLedger[]

  @@index([clubId, startsAt])
}

model RewardTier {
  id          String     @id @default(cuid())
  seasonId    String
  rankFrom    Int
  rankTo      Int
  type        RewardType
  minDiscount Int
  maxDiscount Int
  validDays   Int        @default(30)
  label       String?

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
}

model Reward {
  id              String       @id @default(cuid())
  userId          String
  clubId          String?
  seasonId        String?
  type            RewardType
  status          RewardStatus @default(UNSCRATCHED)
  discountPercent Int
  code            String       @unique
  rank            Int?
  title           String
  note            String?
  expiresAt       DateTime?
  revealedAt      DateTime?
  redeemedAt      DateTime?
  courseId        String?
  createdAt       DateTime     @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  club   Club?   @relation(fields: [clubId], references: [id], onDelete: SetNull)
  season Season? @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

model Course {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  price       Int
  imageUrl    String?
  category    String   @default("General")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  redemptions Reward[]
}

model PointsLedger {
  id        String   @id @default(cuid())
  userId    String
  clubId    String
  seasonId  String?
  amount    Int
  reason    String
  gameId    String?
  questId   String?
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  club   Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  season Season? @relation(fields: [seasonId], references: [id], onDelete: SetNull)

  @@index([clubId, seasonId])
  @@index([userId])
}
