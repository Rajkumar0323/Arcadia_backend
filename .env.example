# PostgreSQL connection string (Neon / Supabase / Railway / local)
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Clerk (Dashboard -> API Keys). Same app as the frontend.
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed frontend origins (CORS)
FRONTEND_URL="http://localhost:3000"

# Comma-separated emails that are automatically promoted to ADMIN on sign-in
ADMIN_EMAILS="you@example.com"

# Automatically finalize ended seasons & issue rewards every hour (true/false)
AUTO_FINALIZE_SEASONS=true
